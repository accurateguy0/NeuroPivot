@if (activeSubCategory == "senses")
{
    <div class="subcategory-view-container animated-fade-in">
        <div class="sub-nav-bar">
            <button type="button" class="btn-sub-back" @onclick='() => activeSubCategory = "more"'>
                ← back
            </button>
        </div>

        <div class="vertical-grid-choice">
            <!-- eye -->
            <button class="choice-card-btn" @onclick='() => OnSelectGoal.InvokeAsync(("eye", "recommended"))'>
                <div>
                    <div class="choice-title">eye</div>
                    <div class="choice-subtitle">panoramic vision, near-far training & optic health</div>
                </div>
                <div class="choice-arrow blue">→</div>
            </button>

            <!-- hearing -->
            <button class="choice-card-btn" @onclick='() => OnSelectGoal.InvokeAsync(("hearing", "recommended"))'>
                <div>
                    <div class="choice-title">hearing</div>
                    <div class="choice-subtitle">40 hz gamma entrainment & acoustic balance</div>
                </div>
                <div class="choice-arrow pink">→</div>
            </button>

            <!-- smell -->
            <button class="choice-card-btn" @onclick='() => OnSelectGoal.InvokeAsync(("smell", "recommended"))'>
                <div>
                    <div class="choice-title">smell</div>
                    <div class="choice-subtitle">olfactory neurogenesis, chemosensation & nasal airflow</div>
                </div>
                <div class="choice-arrow blue">→</div>
            </button>

            <!-- taste -->
            <button class="choice-card-btn" @onclick='() => OnSelectGoal.InvokeAsync(("taste", "recommended"))'>
                <div>
                    <div class="choice-title">taste</div>
                    <div class="choice-subtitle">gustatory acuity, taste bud regeneration & mindful flavor</div>
                </div>
                <div class="choice-arrow pink">→</div>
            </button>
        </div>
    </div>
}
else if (activeSubCategory == "more")
{
    <div class="subcategory-view-container animated-fade-in">
        <div class="sub-nav-bar">
            <button type="button" class="btn-sub-back" @onclick='() => activeSubCategory = ""'>
                ← back
            </button>
        </div>

        <div class="vertical-grid-choice">
            <!-- carl jung -->
            <button class="choice-card-btn" @onclick='() => OnSelectGoal.InvokeAsync(("carl_jung", "recommended"))'>
                <div>
                    <div class="choice-title">carl jung</div>
                    <div class="choice-subtitle">shadow integration, complexes & soul individuation</div>
                </div>
                <div class="choice-arrow blue">→</div>
            </button>

            <!-- pain -->
            <button class="choice-card-btn" @onclick='() => OnSelectGoal.InvokeAsync(("pain", "recommended"))'>
                <div>
                    <div class="choice-title">pain</div>
                    <div class="choice-subtitle">mcgill spine stability & sensory gating</div>
                </div>
                <div class="choice-arrow pink">→</div>
            </button>

            <!-- performance -->
            <button class="choice-card-btn" @onclick='() => OnSelectGoal.InvokeAsync(("performance", "recommended"))'>
                <div>
                    <div class="choice-title">performance</div>
                    <div class="choice-subtitle">palmar cooling & core temperature regulation</div>
                </div>
                <div class="choice-arrow blue">→</div>
            </button>

            <!-- brain -->
            <button class="choice-card-btn" @onclick='() => OnSelectGoal.InvokeAsync(("brain", "recommended"))'>
                <div>
                    <div class="choice-title">brain</div>
                    <div class="choice-subtitle">neuroprotection, stroke prevention & stem cell plasticity</div>
                </div>
                <div class="choice-arrow pink">→</div>
            </button>

            <!-- hormones -->
            <button class="choice-card-btn" @onclick='() => OnSelectGoal.InvokeAsync(("hormones", "recommended"))'>
                <div>
                    <div class="choice-title">hormones</div>
                    <div class="choice-subtitle">testosterone, estrogen & endocrine optimization</div>
                </div>
                <div class="choice-arrow blue">→</div>
            </button>

            <!-- skin -->
            <button class="choice-card-btn" @onclick='() => OnSelectGoal.InvokeAsync(("skin", "recommended"))'>
                <div>
                    <div class="choice-title">skin</div>
                    <div class="choice-subtitle">dermal health, collagen synthesis & photobiology</div>
                </div>
                <div class="choice-arrow pink">→</div>
            </button>

            <!-- senses (nested subcategory group inside more) -->
            <button class="choice-card-btn" @onclick='() => activeSubCategory = "senses"'>
                <div>
                    <div class="choice-title">senses</div>
                    <div class="choice-subtitle">eye, hearing, smell & taste sensory pathways</div>
                </div>
                <div class="choice-arrow blue">&gt;</div>
            </button>
        </div>
    </div>
}
else
{
    <div class="vertical-grid-choice animated-fade-in">
        <!-- 1. sleep -->
        <button class="choice-card-btn" @onclick='() => OnSelectGoal.InvokeAsync(("sleep", "sleep_questionnaire"))'>
            <div>
                <div class="choice-title">sleep</div>
                <div class="choice-subtitle">circadian alignment & restorative recovery</div>
            </div>
            <div class="choice-arrow blue">→</div>
        </button>

        <!-- 2. habits -->
        <button class="choice-card-btn" @onclick='() => OnSelectGoal.InvokeAsync(("habits", "habit_questionnaire"))'>
            <div>
                <div class="choice-title">habits</div>
                <div class="choice-subtitle">friction dynamics & long-term depression</div>
            </div>
            <div class="choice-arrow pink">→</div>
        </button>

        <!-- 3. eating -->
        <button class="choice-card-btn" @onclick='() => OnSelectGoal.InvokeAsync(("eating", "eating_questionnaire"))'>
            <div>
                <div class="choice-title">eating</div>
                <div class="choice-subtitle">metabolic health & gut microbiome diversity</div>
            </div>
            <div class="choice-arrow blue">→</div>
        </button>

        <!-- 4. focus -->
        <button class="choice-card-btn" @onclick='() => OnSelectGoal.InvokeAsync(("focus", "focus_questionnaire"))'>
            <div>
                <div class="choice-title">focus</div>
                <div class="choice-subtitle">ultradian cycles & visual target fixation</div>
            </div>
            <div class="choice-arrow pink">→</div>
        </button>

        <!-- 5. stress -->
        <button class="choice-card-btn" @onclick='() => OnSelectGoal.InvokeAsync(("stress", "recommended"))'>
            <div>
                <div class="choice-title">stress</div>
                <div class="choice-subtitle">physiological sighs & stress-enhancing mindset</div>
            </div>
            <div class="choice-arrow blue">→</div>
        </button>

        <!-- 6. emotions -->
        <button class="choice-card-btn" @onclick='() => OnSelectGoal.InvokeAsync(("emotions", "recommended"))'>
            <div>
                <div class="choice-title">emotions</div>
                <div class="choice-subtitle">grief processing, interoception & oxytocin bonding</div>
            </div>
            <div class="choice-arrow pink">→</div>
        </button>

        <!-- 7. exercise -->
        <button class="choice-card-btn" @onclick='() => OnSelectGoal.InvokeAsync(("exercise", "recommended"))'>
            <div>
                <div class="choice-title">exercise</div>
                <div class="choice-subtitle">henneman size principle & resistance training</div>
            </div>
            <div class="choice-arrow blue">→</div>
        </button>

        <!-- 8. more (subcategory group) -->
        <button class="choice-card-btn" @onclick='() => activeSubCategory = "more"'>
            <div>
                <div class="choice-title">more</div>
                <div class="choice-subtitle">carl jung, pain, performance, brain, hormones, skin & senses</div>
            </div>
            <div class="choice-arrow pink">&gt;</div>
        </button>
    </div>
}

@code {
    [Parameter]
    public EventCallback<(string goal, string targetView)> OnSelectGoal { get; set; }

    private string activeSubCategory = "";
}
