    private List<FactQuote> FilteredQuotes
    {
        get
        {
            string raw = (AppState.CurrentGoal ?? "").Trim().ToLower();
            string target = raw.Replace(" ", "_").Replace("-", "_");
            if (string.IsNullOrWhiteSpace(target)) target = "focus";
            if (target.Contains("jung")) target = "carl_jung";
            if (target.Contains("eye") || target.Contains("vision") || target.Contains("eyesight")) target = "eye";
            if (target.Contains("sleep")) target = "sleep";
            if (target.Contains("habit")) target = "habits";
            if (target.Contains("eat") || target.Contains("nutrition") || target.Contains("diet")) target = "eating";
            if (target.Contains("stress")) target = "stress";
            if (target.Contains("pain") || target.Contains("back")) target = "pain";
            if (target.Contains("hear") || target.Contains("audio")) target = "hearing";
            if (target.Contains("emotion") || target.Contains("grief")) target = "emotions";
            if (target.Contains("exercise") || target.Contains("muscle")) target = "exercise";
            if (target.Contains("perform")) target = "performance";
            if (target.Contains("brain") || target.Contains("stroke") || target.Contains("neuro")) target = "brain";
            if (target.Contains("hormone") || target.Contains("testosterone") || target.Contains("estrogen") || target.Contains("steroid") || target.Contains("endocrine")) target = "hormones";
            if (target.Contains("skin") || target.Contains("dermal") || target.Contains("collagen") || target.Contains("acne") || target.Contains("dermatology")) target = "skin";
            if (target.Contains("smell") || target.Contains("olfact") || target.Contains("chemosens") || target.Contains("sniff") || target.Contains("aroma")) target = "smell";
            if (target.Contains("taste") || target.Contains("gustat") || target.Contains("flavor") || target.Contains("tongue") || target.Contains("sweet") || target.Contains("umami")) target = "taste";

            var list = quotes.Where(q => q.Goal.Equals(target, StringComparison.OrdinalIgnoreCase)).ToList();
            if (list.Any()) return list;

            return quotes.Where(q => q.Goal.Equals("focus", StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

    private FactQuote CurrentQuote
    {
        get
        {
            var list = FilteredQuotes;
            if (currentQuoteIndex >= list.Count) currentQuoteIndex = 0;
            return list[currentQuoteIndex];
        }
    }

    private int FilteredQuoteIndex => currentQuoteIndex + 1;
    private int FilteredQuoteTotal => FilteredQuotes.Count;

    private static readonly Random random = new();
    private string lastGoal = "";

    protected override void OnInitialized()
    {
        lastGoal = (AppState.CurrentGoal ?? "").Trim().ToLower();
        AppState.OnChange += OnStateChanged;
        PickRandomQuote();
    }

    private void PickRandomQuote()
    {
        var count = FilteredQuotes.Count;
        if (count > 0)
        {
            currentQuoteIndex = random.Next(count);
        }
        else
        {
            currentQuoteIndex = 0;
        }
    }

    private void OnStateChanged()
    {
        string raw = (AppState.CurrentGoal ?? "").Trim().ToLower();
        if (raw != lastGoal)
        {
            lastGoal = raw;
            PickRandomQuote();
            showReadMore = false;
        }
        InvokeAsync(StateHasChanged);
    }

    private async Task HandleNextQuote()
    {
        if (isTransitioning) return;
        isTransitioning = true;
        isInitialMount = false;

        try
        {
            await JSRuntime.InvokeVoidAsync("nobsAudio.playThud", AppState.SoundVolume);
        }
        catch
        {
            // Silently handle if audio interop is unavailable
        }

        // 1. Start seamless sweep animation
        isSweeping = true;
        StateHasChanged();

        // 2. Delay to the exact invisible midpoint (150ms)
        await Task.Delay(150);

        // 3. Update quote state while card is offscreen/invisible
        showReadMore = false;
        var list = FilteredQuotes;
        currentQuoteIndex = (currentQuoteIndex + 1) % list.Count;
        StateHasChanged();

        // 4. Wait for the sweep-in to complete and settle in place
        await Task.Delay(170);

        // 5. Reset sweeping state
        isSweeping = false;
        isTransitioning = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        AppState.OnChange -= OnStateChanged;
    }
}