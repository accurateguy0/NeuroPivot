@using System.Security.Cryptography.Xml
@using NeuroPivot.Components.Pages.Articles.Models
@inject AppState AppState
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="recommended-quote-square nobs-square-card @(isInitialMount ? "rec-card-reveal" : "") @(isSweeping ? "quote-sweep" : "")" style="position: relative;">
    <h2 class="quote-headline-baskerville @(isInitialMount ? "rec-headline-reveal" : "")">
        "@CurrentQuote.Headline"
    </h2>

    @if (!showReadMore)
    {
        <button class="read-more-plain-link" @onclick="() => ToggleReadMore(true)">
            ...read more
        </button>
    }
    else
    {
        <div class="quote-expanded-body @(isCollapsing ? "collapsing" : "")">
            <p style="margin-bottom: 1rem; line-height: 1.7;">@CurrentQuote.Body</p>
            <div class="quote-reference">
                @if (CurrentQuote.AdditionalReferences == null || !CurrentQuote.AdditionalReferences.Any())
                {
                    <span>📌 Reference: </span>
                    @if (!string.IsNullOrEmpty(CurrentQuote.ReferenceUrl))
                    {
                        <a href="@CurrentQuote.ReferenceUrl" target="_blank" rel="noopener noreferrer" class="quote-ref-link">
                            @CurrentQuote.Reference ↗
                        </a>
                    }
                    else
                    {
                        @CurrentQuote.Reference
                    }
                }
                else
                {
                    <div class="quote-ref-heading">📌 References:</div>
                    <div class="quote-ref-list">
                        @if (!string.IsNullOrEmpty(CurrentQuote.Reference))
                        {
                            <div class="quote-ref-item">
                                <span class="ref-bullet">•</span>
                                @if (!string.IsNullOrEmpty(CurrentQuote.ReferenceUrl))
                                {
                                    <a href="@CurrentQuote.ReferenceUrl" target="_blank" rel="noopener noreferrer" class="quote-ref-link">
                                        @CurrentQuote.Reference ↗
                                    </a>
                                }
                                else
                                {
                                    <span>@CurrentQuote.Reference</span>
                                }
                            </div>
                        }
                        @foreach (var refItem in CurrentQuote.AdditionalReferences)
                        {
                            <div class="quote-ref-item">
                                <span class="ref-bullet">•</span>
                                @if (!string.IsNullOrEmpty(refItem.Url))
                                {
                                    <a href="@refItem.Url" target="_blank" rel="noopener noreferrer" class="quote-ref-link">
                                        @refItem.Label ↗
                                    </a>
                                }
                                else
                                {
                                    <span>@refItem.Label</span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
            <div style="margin-top: 1rem;">
                <button class="read-more-plain-link" @onclick="() => ToggleReadMore(false)">
                    ...read less
                </button>
            </div>
        </div>
    }

    <!-- Action Bar: Counter and Lowercase 'next →' button -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 1.75rem;">
        <div style="font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-muted);">
            @FilteredQuoteIndex / @FilteredQuoteTotal
        </div>
        <button class="btn-next-reactive" @onclick="HandleNextQuote" disabled="@isTransitioning">
            next →
        </button>
    </div>
</div>

