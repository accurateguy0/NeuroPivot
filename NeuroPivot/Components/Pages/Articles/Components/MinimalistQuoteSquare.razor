    {
        if (!open)
        {
            isCollapsing = true;
            StateHasChanged();
            await Task.Delay(520);
            showReadMore = false;
            isCollapsing = false;
            StateHasChanged();
        }
        else
        {
            showReadMore = true;
        }
    }

