    private MarkupString RenderAnimatedLetters(string text, int startDelayIdx = 0)
    {
        if (string.IsNullOrEmpty(text)) return new MarkupString("");
        var sb = new System.Text.StringBuilder();
        int idx = startDelayIdx;
        foreach (char c in text)
        {
            if (c == ' ')
            {
                sb.Append("<span class=\"char-mask space relative inline-block\"><span class=\"fade-up-char block space\" style=\"--char-idx:").Append(idx).Append(";\">&nbsp;</span></span>");
            }
            else
            {
                sb.Append("<span class=\"char-mask relative inline-block overflow-hidden\"><span class=\"fade-up-char block\" style=\"--char-idx:").Append(idx).Append(";\">")
                  .Append(System.Net.WebUtility.HtmlEncode(c.ToString()))
                  .Append("</span></span>");
            }
            idx++;
        }
        return new MarkupString(sb.ToString());
    }

