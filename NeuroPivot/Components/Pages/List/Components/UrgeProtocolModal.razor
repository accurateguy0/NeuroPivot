                </div>

                <!-- SCENE 2.3: SOMATIC AWARENESS / AFFECT LABELING (STANDALONE FULL-SCREEN) -->
                <div id="urge-scene-affect" class="urge-scene-layer affect-scene" style="display: none; opacity: 0;">
                    <div class="affect-fullpage-content">
                        @if (!isAffectBridgeFadedIn)
                        {
                            <div class="affect-ambient-ring"></div>
                            <span class="affect-kicker">SOMATIC INTEROCEPTION</span>
                            <h2 class="affect-giant-heading">What are you feeling in your body right now?</h2>
                            <p class="affect-subheading">Labeling physical sensations de-escalates amygdala hyperactivity before entering coherent breathing.</p>
                            
                            <div class="affect-box-container">
                                <div class="affect-input-wrap">
                                    <input type="text" 
                                           class="affect-input" 
                                           maxlength="80" 
                                           placeholder="e.g. tight chest, racing thoughts, restless..." 
                                           @bind="affectLabelText" 
                                           @bind:event="oninput" 
                                           @onkeydown="HandleAffectKeyDown" />
                                    <span class="affect-char-counter">@(affectLabelText?.Length ?? 0)/80</span>
                                </div>
                                <div class="affect-action-row">
                                    @if (!string.IsNullOrWhiteSpace(affectLabelText))
                                    {
                                        <button type="button" class="btn-affect-save" @onclick="SaveAffectLabel">Save & Acknowledge</button>
                                    }
