                        else
                        {
                            <div class="affect-bridge-in-place anim-fade-in-bridge">
                                @if (isAffectLabelSaved)
                                {
                                    <div class="affect-saved-blended-pill">saved ✓</div>
                                }
                                <div class="bridge-noise-ambient-ring"></div>
                                <h2 class="bridge-giant-quote">“Let's leave all the noise behind.”</h2>
                                <p class="bridge-subtext">Take a breath. We're going to slow everything down and breathe together for 90 seconds. Scroll down to start.</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- SCENE 2.5: COGNITIVE BRIDGE (STANDALONE FULL-SCREEN INTERVENTION) -->
                <div id="urge-scene-bridge" class="urge-scene-layer bridge-scene" style="display: none; opacity: 0;">
                    <div class="bridge-fullpage-content">
                        <div class="bridge-noise-ambient-ring"></div>
                        <h2 class="bridge-giant-quote">“Let's leave all the noise behind.”</h2>
                        <p class="bridge-subtext">Take a breath. We're going to slow everything down and breathe together for 90 seconds. Scroll down to start.</p>
                    </div>
                </div>

                <!-- SCENE 3: BIOPHILIC BREATHING EXERCISE -->
                <div id="urge-scene-3" class="urge-scene-layer nature-breathing-scene" style="display: none; opacity: 0;">
                    <h2 class="slide-headline">Breathing Exercise</h2>

                    <div class="hero-expanding-video-box nature-video-frame" id="natureExpandingBox">
                        <video id="natureVideoPlayer" 
                                class="hero-cinematic-video" 
                                autoplay 
                                muted 
                                playsinline 
                                preload="auto"
                                @onclick="HandleNatureVideoClick">
                            <source src="videos/nature_wildlife.mp4" type="video/mp4" />
                            <source src="videos/water_beach_video.mp4" type="video/mp4" />
                        </video>

                        <!-- Sound Toggle Pill Button for Nature Sound Only -->
                        <button type="button" 
                                id="natureSoundBtn" 
                                class="video-sound-btn" 
                                @onclick="ToggleNatureSound" 
                                aria-label="Toggle nature sound">
                            @if (!isNatureMuted)
                            {
                                <span>
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                                        <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                                    </svg>
                                    <span class="sound-text">SOUND ON</span>
                                </span>
                            }
                            else
                            {
                                <span>
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                                        <line x1="23" y1="9" x2="17" y2="15"></line>
                                        <line x1="17" y1="9" x2="23" y2="15"></line>
                                    </svg>
                                    <span class="sound-text">SOUND OFF</span>
                                </span>
                            }
                        </button>
                    </div>

                    <div class="breath-deck-container">
                        <div class="breath-live-status-pill intro-listen" id="breathLivePill">
                            <span class="phase-live-label" id="phaseLiveLabel">HRV PROTOCOL INTRO</span>
                            <span class="phase-live-timer" id="phaseLiveTimer">0:25</span>
                        </div>
                        <div class="breath-live-caption-box breath-caption-live-box" id="breathLiveCaptionBox">
                            <p class="breath-caption-text" id="breathCaptionText">
                                Coherent breathing specifically for heart rate variability (HRV).
                            </p>
                        </div>
                    </div>
                </div>

                <!-- SCENE 4: VICTORY LOCK & ACTION DIVERGENCE (APPROACH-IDENTITY REFRAMED) -->
                <div id="urge-scene-4" class="urge-scene-layer victory-scene" style="display: none; opacity: 0;">
                    <div class="victory-hero-box">
                        <h2 class="victory-title">You chose this. Day @HabitService.GetConsecutiveStreak() is yours.</h2>
                        <p class="victory-body">
                            You just physically rewired your brain. That's not willpower — that's biology. Every second you held the line weakened the old loop and reinforced the new standard.
                        </p>
                    </div>

                    <div class="victory-counter-flash-box @(isActionTriggered ? "box-glow-confirmed" : "")">
                        <span class="vcf-kicker">SYNAPTIC RESISTANCE REINFORCED</span>
                        <div class="vcf-count-row">
                            <span class="vcf-label">URGES SURFED</span>
                            <div class="vcf-number-slot">
                                <span class="vcf-digit current @(isActionTriggered ? "anim-slide-out-left" : "")">
                                    @Math.Max(0, AppState.UrgesSurfedCount)
                                </span>
                                @if (isActionTriggered)
                                {
                                    <span class="vcf-digit next anim-slide-in-right">
                                        @(AppState.UrgesSurfedCount + 1)
                                    </span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="exit-action-header-row">
                        <h3 class="exit-action-title">What would be your first step now?</h3>
                    </div>

                    <div class="exit-actions-grid @(isBreathingGateUnlocked ? "" : "is-gated")" 
                         id="exitActionsGrid"
                         @onmousemove="HandleExitGridMouseMove"
                         @onmouseleave="HandleExitGridMouseLeave">
                        <button type="button" 
                                class="exit-action-btn primary @(selectedActionIndex == 0 ? "btn-blinking-lights" : "")" 
                                disabled="@(isActionTriggered || !isBreathingGateUnlocked)"
                                @onclick='() => HandleFinishAction("Return to 21-Day Habit Challenge", 0)'>
                            <span class="ea-icon">⚔️</span>
                            <div class="ea-text">
                                <div class="ea-name">Return to 21-Day Habit Challenge</div>
                                <div class="ea-desc">Resume daily protocol execution with clean slate & unwavering focus</div>
                            </div>
                            <span class="ea-arrow">→</span>
                        </button>

                        <button type="button" 
                                class="exit-action-btn @(selectedActionIndex == 1 ? "btn-blinking-lights" : "")" 
                                disabled="@(isActionTriggered || !isBreathingGateUnlocked)"
                                @onclick='() => HandleFinishAction("Restorative body care", 1)'>
                            <span class="ea-icon">💧</span>
                            <div class="ea-text">
                                <div class="ea-name">Do something restorative for your body</div>
                                <div class="ea-desc">Drink 500ml cold water, wash face, or step outside into fresh air</div>
                            </div>
                            <span class="ea-arrow">→</span>
                        </button>

                        <button type="button" 
                                class="exit-action-btn @(selectedActionIndex == 2 ? "btn-blinking-lights" : "")" 
                                disabled="@(isActionTriggered || !isBreathingGateUnlocked)"
                                @onclick='() => HandleFinishAction("Connect with someone", 2)'>
                            <span class="ea-icon">💬</span>
                            <div class="ea-text">
                                <div class="ea-name">Connect with someone who matters</div>
                                <div class="ea-desc">Text a friend or family member, or go be around people</div>
                            </div>
                            <span class="ea-arrow">→</span>
                        </button>
                    </div>

                    @if (!isBreathingGateUnlocked && isHoveringGatedExit)
                    {
                        <div class="cursor-gated-tooltip" style="left: @(tooltipX)px; top: @(tooltipY)px;">
                            finish the breathing first
                        </div>
                    }
                </div>

            </div>
        </div>
    </div>
}

<ImageCropModal IsOpen="@isCropModalOpen"
                ImageSrc="@cropImageSrc"
                Title="Frame &amp; Crop Photo"
                Subtitle="Drag to position the face in the frame. Use the slider or wheel to zoom."
                AspectWidth="3"
                AspectHeight="4"
                OnConfirmed="HandleCropConfirmed"
                OnCancelled="HandleCropCancelled" />

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    // Image Crop Modal State
    private bool isCropModalOpen = false;
    private string? cropImageSrc = null;
    private string? pendingCropCardId = null;
    private bool pendingIsNewCard = false;
    private string? pendingCategory = null;

    // Video Player State - Default sound is strictly OFF (muted = true)
    private bool isShuzoMuted = true;
    private bool isShuzoEnded = false;

    private async Task HandleShuzoEnded()
    {
        isShuzoEnded = true;
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", @"
                if (window.nobsProduxScrollytelling) {
                    window.nobsProduxScrollytelling._shuzoEnded = true;
                }
            ");
        }
        catch { }
        StateHasChanged();
    }

    private async Task HandleVideoClick()
    {
        if (isShuzoEnded)
        {
            await ReplayShuzo();
        }
    }

    private async Task ReplayShuzo()
    {
        isShuzoEnded = false;
        StateHasChanged();
        try
        {
            await JSRuntime.InvokeVoidAsync("nobsProduxScrollytelling.replayShuzo");
        }
        catch { }
    }

    private async Task ToggleShuzoSound()
    {
        isShuzoMuted = !isShuzoMuted;
        try
        {
            var mutedVal = isShuzoMuted ? "true" : "false";
            await JSRuntime.InvokeVoidAsync("eval", @"
                const v = document.getElementById('shuzoVideoPlayer');
                if (v) {
                    v.muted = " + mutedVal + @";
                }
            ");
        }
        catch { }
    }

    private bool isNatureMuted = true;

    private async Task ToggleNatureSound()
    {
        isNatureMuted = !isNatureMuted;
        try
        {
            var mutedVal = isNatureMuted ? "true" : "false";
            await JSRuntime.InvokeVoidAsync("eval", @"
                const isMuted = " + mutedVal + @";
                const nv = document.getElementById('natureVideoPlayer');
                if (nv) {
                    nv.muted = isMuted;
                    if (!isMuted) {
                        nv.volume = 0.35;
                        if (nv.paused) nv.play().catch(() => {});
                    } else {
                        nv.volume = 0;
                    }
                }
                if (window.nobsProduxScrollytelling) {
                    window.nobsProduxScrollytelling.toggleNatureSound(isMuted);
                }
            ");
        }
        catch { }
    }

    private Task ToggleBreathingSound() => ToggleNatureSound();

    private async Task HandleNatureVideoClick()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("nobsProduxScrollytelling.switchNatureVideo");
        }
        catch { }
    }

    private bool isBgMusicMuted = false;

    private async Task ToggleBgMusic()
    {
        isBgMusicMuted = !isBgMusicMuted;
        try
        {
            var mutedVal = isBgMusicMuted ? "true" : "false";
            await JSRuntime.InvokeVoidAsync("eval", @"
                const bg = document.getElementById('urgeBgMusic');
                if (bg) {
                    bg.muted = " + mutedVal + @";
                    if (!bg.muted && bg.paused) {
                        bg.volume = 0.45;
                        bg.play().catch(() => {});
                    }
                }
            ");
        }
        catch { }
    }

    private bool isCallMyNameMuted = true;

    private async Task ToggleCallMyNameSound()
    {
        isCallMyNameMuted = !isCallMyNameMuted;
        try
        {
            await JSRuntime.InvokeVoidAsync("nobsProduxScrollytelling.toggleCallMyNameSound", isCallMyNameMuted);
        }
        catch { }
        StateHasChanged();
    }

    private void OpenCropForExistingCard(AnchorCardItem card)
    {
        if (string.IsNullOrWhiteSpace(card.ImageUrl)) return;
        cropImageSrc = card.ImageUrl;
        pendingIsNewCard = false;
        pendingCropCardId = card.Id;
        isCropModalOpen = true;
    }

    private async Task HandleCardImageUpload(InputFileChangeEventArgs e, string cardId)
    {
        try
        {
            var file = e.File;
            if (file == null) return;
            var resized = await file.RequestImageFileAsync("image/jpeg", 800, 800);
            using var ms = new MemoryStream();
            await resized.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).CopyToAsync(ms);
            var base64 = Convert.ToBase64String(ms.ToArray());
            var dataUrl = $"data:image/jpeg;base64,{base64}";
            
            cropImageSrc = dataUrl;
            pendingIsNewCard = false;
            pendingCropCardId = cardId;
            isCropModalOpen = true;
            StateHasChanged();
        }
        catch { }
    }

    private int cueCarouselIndex = 0;

    private void PrevCuePhoto()
    {
        if (cueCarouselIndex > 0)
        {
            cueCarouselIndex--;
            StateHasChanged();
        }
    }

    private void NextCuePhoto()
    {
        var photoCardsCount = AppState.GetEffectiveAnchorCards().Count(c => !string.IsNullOrWhiteSpace(c.ImageUrl));
        if (cueCarouselIndex < photoCardsCount)
        {
            cueCarouselIndex++;
            StateHasChanged();
        }
    }

    private string? editingCardId = null;
    private string editingCardTitle = "";

    private void StartEditingCard(AnchorCardItem card)
    {
        editingCardId = card.Id;
        editingCardTitle = card.Title;
        StateHasChanged();
    }

    private async Task SaveCardTitle(string cardId)
    {
        var card = AppState.GetEffectiveAnchorCards().FirstOrDefault(c => c.Id == cardId);
        if (card != null)
        {
            if (!string.IsNullOrWhiteSpace(editingCardTitle))
            {
                card.Title = editingCardTitle.Trim();
            }
            await AppState.AddOrUpdateAnchorCard(card);
        }
        editingCardId = null;
        editingCardTitle = "";
        StateHasChanged();
    }

    private void CancelCardTitle()
    {
        editingCardId = null;
        editingCardTitle = "";
        StateHasChanged();
    }

    private async Task HandleCardTitleKeyDown(KeyboardEventArgs e, string cardId)
    {
        if (e.Key == "Enter")
        {
            await SaveCardTitle(cardId);
        }
        else if (e.Key == "Escape")
        {
            CancelCardTitle();
        }
    }

    private bool isUploadingPhoto = false;

    private async Task HandleCuePhotoUpload(InputFileChangeEventArgs e)
    {
        isUploadingPhoto = true;
        StateHasChanged();
        try
        {
            var file = e.File;
            if (file == null) return;
            var resized = await file.RequestImageFileAsync("image/jpeg", 800, 800);
            using var ms = new MemoryStream();
            await resized.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).CopyToAsync(ms);
            var base64 = Convert.ToBase64String(ms.ToArray());
            var dataUrl = $"data:image/jpeg;base64,{base64}";

            var anchorCards = AppState.GetEffectiveAnchorCards();
            bool hasSelf = anchorCards.Any(c => c.Category == "self" && !string.IsNullOrWhiteSpace(c.ImageUrl));

            cropImageSrc = dataUrl;
            pendingIsNewCard = true;
            pendingCropCardId = null;
            pendingCategory = !hasSelf ? "self" : "loved_ones";
            isCropModalOpen = true;
        }
        catch { }
        finally
        {
            isUploadingPhoto = false;
            StateHasChanged();
        }
    }

    private async Task HandleCropConfirmed(string croppedDataUrl)
    {
        isCropModalOpen = false;
        cropImageSrc = null;
        var wasNewCard = pendingIsNewCard;
        var targetCat = pendingCategory;
        var targetCardId = pendingCropCardId;
        pendingCropCardId = null;
        pendingIsNewCard = false;
        pendingCategory = null;
        StateHasChanged();

        if (wasNewCard)
        {
            var anchorCards = AppState.GetEffectiveAnchorCards();
            string newCardId;
            if (targetCat == "self")
            {
                var selfCard = anchorCards.FirstOrDefault(c => c.Category == "self");
                if (selfCard == null)
                {
                    selfCard = new AnchorCardItem
                    {
                        Id = "default-self",
                        Title = "Younger Self",
                        Category = "self",
                        Note = "Protect this kid. Treat yourself like someone you are responsible for helping.",
                        ImageUrl = croppedDataUrl
                    };
                }
                else
                {
                    selfCard.ImageUrl = croppedDataUrl;
                    if (string.IsNullOrWhiteSpace(selfCard.Title)) selfCard.Title = "Younger Self";
                }
                newCardId = selfCard.Id;
                await AppState.AddOrUpdateAnchorCard(selfCard);
            }
            else
            {
                var lovedCard = new AnchorCardItem
                {
                    Id = Guid.NewGuid().ToString(),
                    Title = "Loved One",
                    Category = "loved_ones",
                    Note = "The people who believe in your highest potential.",
                    ImageUrl = croppedDataUrl
                };
                newCardId = lovedCard.Id;
                await AppState.AddOrUpdateAnchorCard(lovedCard);
            }

            editingCardId = newCardId;
            editingCardTitle = "";

            var updatedCards = AppState.GetEffectiveAnchorCards().Where(c => !string.IsNullOrWhiteSpace(c.ImageUrl)).ToList();
            var targetIdx = updatedCards.FindIndex(c => c.Id == newCardId);
            if (targetIdx >= 0)
            {
                cueCarouselIndex = targetIdx;
            }
        }
        else if (!string.IsNullOrWhiteSpace(targetCardId))
        {
            var card = AppState.GetEffectiveAnchorCards().FirstOrDefault(c => c.Id == targetCardId);
            if (card != null)
            {
                card.ImageUrl = croppedDataUrl;
                await AppState.AddOrUpdateAnchorCard(card);
            }
        }

        StateHasChanged();
    }

    private async Task HandleCueOk()
    {
        bool hasAnyPhotos = AppState.GetEffectiveAnchorCards().Any(c => !string.IsNullOrWhiteSpace(c.ImageUrl));
        try
        {
            // Update JS with current photo state, then unlock the gate
            await JSRuntime.InvokeVoidAsync("nobsProduxScrollytelling.setHasPhotos", hasAnyPhotos);
            await JSRuntime.InvokeVoidAsync("nobsProduxScrollytelling.unlockCueGate", hasAnyPhotos);
        }
        catch { }
    }

    private void HandleCropCancelled()
    {
        isCropModalOpen = false;
        cropImageSrc = null;
        pendingCropCardId = null;
        pendingIsNewCard = false;
        pendingCategory = null;
    }

    // Affect Labeling (Somatic Interoceptive Step)
    private string affectLabelText = "";
    private bool isAffectLabelSaved = false;
    private bool isAffectBridgeFadedIn = false;

    // 90-Second Breathing Gate State & Cursor Tooltip
    private bool isBreathingGateUnlocked = false;
    private bool isHoveringGatedExit = false;
    private double tooltipX = 0;
    private double tooltipY = 0;
    private DotNetObjectReference<UrgeProtocolModal>? _dotNetRef;

    private void HandleExitGridMouseMove(MouseEventArgs e)
    {
        if (!isBreathingGateUnlocked)
        {
            isHoveringGatedExit = true;
            tooltipX = e.ClientX + 14;
            tooltipY = e.ClientY + 14;
        }
    }

    private void HandleExitGridMouseLeave()
    {
        isHoveringGatedExit = false;
    }

    private async Task SaveAffectLabel()
    {
        if (string.IsNullOrWhiteSpace(affectLabelText)) return;
        var trimmed = affectLabelText.Trim();
        if (trimmed.Length > 80) trimmed = trimmed.Substring(0, 80);

        isAffectLabelSaved = true;
        isAffectBridgeFadedIn = true;
        try
        {
            // Unlock scroll gate in JS without jumping scroll position
            await JSRuntime.InvokeVoidAsync("nobsProduxScrollytelling.unlockAffectGate");

            // Save somatic affect reflection directly into today's DailyMoodEntry notes
            var today = DateTime.Today;
            var existing = AppState.DailyMoodLogs.FirstOrDefault(l => l.Date.Date == today);
            if (existing != null)
            {
                var prefix = string.IsNullOrWhiteSpace(existing.Note) ? "" : $"{existing.Note} | ";
                existing.Note = $"{prefix}[Urge Somatic: {trimmed}]";
                AppState.AddDailyMoodLog(existing);
            }
            else
            {
                var newEntry = new DailyMoodEntry
                {
                    Date = today,
                    MoodTag = "good",
                    Note = $"[Urge Somatic: {trimmed}]",
                    HabitsCompletedOnDay = HabitService.Habits.Count(h => h.IsCompletedOnDay(HabitService.CurrentActiveDay)),
                    TotalHabitsCount = HabitService.Habits.Count > 0 ? HabitService.Habits.Count : 6
                };
                AppState.AddDailyMoodLog(newEntry);
            }
        }
        catch { }
        StateHasChanged();
    }

    private async Task SkipAffectLabel()
    {
        isAffectBridgeFadedIn = true;
        try
        {
            await JSRuntime.InvokeVoidAsync("nobsProduxScrollytelling.unlockAffectGate");
        }
        catch { }
        StateHasChanged();
    }

    private async Task HandleAffectKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SaveAffectLabel();
        }
    }

    [JSInvokable]
    public void UnlockBreathingGate()
    {
        if (!isBreathingGateUnlocked)
        {
            isBreathingGateUnlocked = true;
            InvokeAsync(StateHasChanged);
        }
    }

    // Breathing Timer State (Heart Coherence / HRV: 5s Inhale / 5s Exhale)
    private bool _wasOpen = false;
    private bool isActionTriggered = false;
    private int selectedActionIndex = -1;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpen && !_wasOpen)
        {
            _wasOpen = true;
            isActionTriggered = false;
            selectedActionIndex = -1;
            isBgMusicMuted = false;
            isShuzoMuted = true;
            isNatureMuted = true;
            isShuzoEnded = false;
            isCallMyNameMuted = true;
            affectLabelText = "";
            isAffectLabelSaved = false;
            isAffectBridgeFadedIn = false;
            isBreathingGateUnlocked = false;
            isHoveringGatedExit = false;
            editingCardId = null;
            editingCardTitle = "";

            _dotNetRef?.Dispose();
            _dotNetRef = DotNetObjectReference.Create(this);

            try
            {
                if (_dotNetRef != null)
                {
                    await JSRuntime.InvokeVoidAsync("nobsProduxScrollytelling.setDotNetHelper", _dotNetRef);
                }
                bool hasAnyPhotos = AppState.GetEffectiveAnchorCards().Any(c => !string.IsNullOrWhiteSpace(c.ImageUrl));
                await JSRuntime.InvokeVoidAsync("nobsProduxScrollytelling.setHasPhotos", hasAnyPhotos);
                await JSRuntime.InvokeVoidAsync("nobsProduxScrollytelling.init", true, hasAnyPhotos);
            }
            catch { }
        }
        else if (!IsOpen && _wasOpen)
        {
            _wasOpen = false;
        }
    }

