@inject HabitService HabitService
@inject AppState AppState
@inject IJSRuntime JSRuntime
@using System.Globalization
@implements IDisposable

@if (IsOpen)
{
    <div class="modal-backdrop-overlay" id="urgeModalBackdrop">
        <!-- Centered Pinned Modal Card with PRODUX Scrollytelling -->
        <div class="nobs-modal-card urge-modal-square" 
             id="urgePinnedCard"
             @onclick:stopPropagation="true">
            
            <!-- Background Ambient Music ("The City of Lost Hope") -->
            <audio id="urgeBgMusic" src="sounds/the_city_of_lost_hope.mp3" preload="auto"></audio>

            <!-- Biophilic Mountain & Ocean Waves Ambience Audio -->
            <audio id="mountainAmbienceAudio" src="sounds/mountain_ambience.wav" preload="auto" loop></audio>
            <audio id="waterWavesAudio" src="sounds/water_wave_sound.mp3" preload="auto" loop></audio>

            <!-- Biophilic Heart Coherence Guided Breathing Audio -->
            <audio id="breathingAudioPlayer" preload="auto" playsinline>
                <source src="sounds/breathing_exercise.mp3" type="audio/mpeg" />
                <source src="sounds/breathing_exercise.m4a" type="audio/mp4" />
            </audio>

            <!-- Modal Header: Persistent '✕' Close Button -->
            <div class="urge-modal-header">
                <div class="urge-header-actions">
                    <button type="button" class="modal-close-btn" @onclick="HandleCancel" aria-label="Close">✕</button>
                </div>
            </div>

            <!-- Master Scrollytelling Scenes Stage -->
            <div class="urge-scenes-stage">
                
                <!-- SCENE PRE-0: STATS INTRO (STANDALONE FULL-SCREEN REFLECTION) -->
                <div id="urge-scene-stats-intro" class="urge-scene-layer stats-intro-scene">
                    <div class="stats-intro-fullpage-content">
                        <div class="stats-intro-ambient-ring"></div>
                        
                        <h2 class="stats-intro-giant-quote">let's look at your past stats</h2>
                    </div>
                </div>

                <!-- SCENE 0: PERSISTENCE WRAPPED (Continuous Vertical Scroll Stream) -->
                <div id="urge-scene-0" class="urge-scene-layer spotify-scene">

                    <!-- Vertical Scroll Stream Container -->
                    <div class="spotify-data-scroll-container" id="spotifyDataScrollContainer">
                        <div class="spotify-data-stream" id="spotifyDataStream">
                            
                            <!-- SECTION 1: TOP STREAK -->
                            <div class="spotify-data-section">
                                <div class="spotify-big-title-wrap">
                                    <span class="spotify-kicker-label">@RenderAnimatedLetters("UNWAVERING MOMENTUM", 0)</span>
                                    <h2 class="spotify-giant-heading">@RenderAnimatedLetters("TOP STREAK", 19)</h2>
                                </div>

                                <div class="spotify-hero-metric-card folder-card-streak folder-card-streak-prime">
                                    <div class="folder-tab">
                                        <span class="folder-tab-text">@RenderAnimatedLetters("UNBROKEN CHAIN", 28)</span>
                                    </div>
                                    <div class="folder-content">
                                        <video id="mountainTimelapseVideo" class="folder-mountain-video" autoplay loop muted playsinline preload="auto">
                                            <source src="videos/mountain_timelapse.mp4" type="video/mp4" />
                                        </video>
                                        <div class="folder-mountain-overlay"></div>
                                        <div class="hero-metric-body relative-z hero-metric-body-prime">
                                            <span class="hero-stat-huge hero-stat-mega">@RenderAnimatedLetters(HabitService.GetHighestStreak().ToString(), 41)</span>
                                            <div class="hero-stat-details">
                                                <span class="hero-stat-unit">@RenderAnimatedLetters("DAYS", 44)</span>
                                                <span class="hero-stat-subtext">@RenderAnimatedLetters("Unbroken chain of discipline", 48)</span>
                                            </div>
                                        </div>
                                        <div class="folder-bottom-banner banner-streak relative-z">
                                            <span class="folder-banner-label">BEFORE A 10-MIN URGE ERASES YOUR MOMENTUM</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- SECTION 2: DAYS COMPLETED -->
                            <div class="spotify-data-section">
                                <div class="spotify-big-title-wrap">
                                    <span class="spotify-kicker-label">@RenderAnimatedLetters("HIGH-OUTPUT EXECUTION", 0)</span>
                                    <h2 class="spotify-giant-heading">@RenderAnimatedLetters("DAYS COMPLETED", 20)</h2>
                                </div>

                                <div class="spotify-hero-metric-card folder-card-output">
                                    <div class="folder-tab">
                                        <span class="folder-tab-text">@RenderAnimatedLetters("4+ DAILY BENCHMARK", 34)</span>
                                    </div>
                                    <div class="folder-content">
                                        <div class="hero-metric-body">
                                            <span class="hero-stat-huge">@RenderAnimatedLetters(HabitService.GetQualifiedDaysCount().ToString(), 52)</span>
                                            <div class="hero-stat-details">
                                                <span class="hero-stat-unit">@RenderAnimatedLetters("DAYS", 55)</span>
                                                <span class="hero-stat-subtext">@RenderAnimatedLetters("Completed with 4 or more habits", 60)</span>
                                            </div>
                                        </div>
                                        <div class="folder-bottom-banner banner-output">
                                            <span class="folder-banner-label">@RenderAnimatedLetters("SOLID NEUROPLASTIC REINFORCEMENT", 90)</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- SECTION 3: CONSISTENCY -->
                            <div class="spotify-data-section">
                                <div class="spotify-big-title-wrap">
                                    <span class="spotify-kicker-label">@RenderAnimatedLetters("EXECUTION RATE", 0)</span>
                                    <h2 class="spotify-giant-heading">@RenderAnimatedLetters("CONSISTENCY", 15)</h2>
                                </div>

                                <div class="spotify-hero-metric-card folder-card-consistency">
                                    <div class="folder-tab">
                                        <span class="folder-tab-text">@RenderAnimatedLetters("HABIT COMPLIANCE", 27)</span>
                                    </div>
                                    <div class="folder-content">
                                        <div class="hero-metric-body">
                                            <span class="hero-stat-huge">
                                                @RenderAnimatedLetters(HabitService.GetHabitsConsistencyPercentage().ToString(), 43)<span class="hero-pct-sign"><span class="char-mask relative inline-block overflow-hidden"><span class="fade-up-char block" style="--char-idx: 46;">%</span></span></span>
                                            </span>
                                            <div class="hero-stat-details">
                                                <span class="hero-stat-unit">@RenderAnimatedLetters("OVERALL", 48)</span>
                                                <span class="hero-stat-subtext">@RenderAnimatedLetters("Active challenge execution ratio", 55)</span>
                                            </div>
                                        </div>
                                        <div class="folder-bottom-banner banner-consistency">
                                            <span class="folder-banner-label">@RenderAnimatedLetters("SYNAPTIC PRUNING IN PROGRESS", 88)</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="spotify-lyric-card">
                                    <div class="spotify-lyric-header">
                                        <span class="spotify-lyric-tag">PERSISTENCE ANCHOR</span>
                                    </div>
                                    <p class="spotify-lyric-text">
                                        <span class="char-mask block overflow-hidden">
                                            <span class="split-line-reveal block">"You didn't build this by accident. You fought for every single day."</span>
                                        </span>
                                    </p>
                                </div>
                            </div>

                            <!-- SECTION 3.5: URGES SURFED -->
                            <div class="spotify-data-section">
                                <div class="spotify-big-title-wrap">
                                    <span class="spotify-kicker-label">@RenderAnimatedLetters("DOPAMINE INTERVENTIONS", 0)</span>
                                    <h2 class="spotify-giant-heading">@RenderAnimatedLetters("URGES SURFED", 22)</h2>
                                </div>

                                <div class="spotify-hero-metric-card folder-card-waves">
                                    <div class="folder-tab">
                                        <span class="folder-tab-text">@RenderAnimatedLetters("NEUROPLASTIC RESISTANCE", 35)</span>
                                    </div>
                                    <div class="folder-content">
                                        <video id="waterWaveVideo" class="folder-water-wave-video" autoplay loop muted playsinline preload="auto">
                                            <source src="videos/water_wave.mp4?v=3" type="video/mp4" />
                                        </video>
                                        <div class="folder-water-wave-overlay"></div>
                                        <div class="hero-metric-body relative-z">
                                            <span class="hero-stat-huge">@RenderAnimatedLetters(AppState.UrgesSurfedCount.ToString(), 55)</span>
                                            <div class="hero-stat-details">
                                                <span class="hero-stat-unit">@RenderAnimatedLetters("WINS", 58)</span>
                                                <span class="hero-stat-subtext">@RenderAnimatedLetters("Chemical cravings faced & extinguished", 63)</span>
                                            </div>
                                        </div>
                                        <div class="folder-bottom-banner banner-waves relative-z">
                                            <span class="folder-banner-label">@RenderAnimatedLetters("LTD SYNAPTIC PRUNING ACTIVE", 95)</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- SECTION 4: DAY DIARY / ORIGIN & HORIZON ARCHIVES -->
                            <div class="spotify-data-section day-diary-data-section">
                                <div class="produx-header-bar">
                                    <div>
                                        <h2 class="slide-headline arena-headline shine-scroll-text">Why you entered this arena.</h2>
                                        <p class="slide-subtext arena-subtext shine-scroll-text">Scroll momentum glides through your origin commitment and timeline archives</p>
                                    </div>
                                </div>

                                <div class="produx-diagonal-viewport">
                                    <div class="produx-diagonal-track" id="produxDiagonalTrack">
                                        @{
                                            var diaryCards = GetDayDiaryCards();
                                        }
                                        @for (int i = 0; i < diaryCards.Count; i++)
                                        {
                                            int dayNum = diaryCards[i];
                                            var cardDate = HabitService.ChallengeStartDate.AddDays(dayNum - 1).Date;
                                            var log = AppState.DailyMoodLogs.FirstOrDefault(l => l.Date.Date == cardDate);
                                            int idx = i;
                                            double leftPx = idx * 400.0;
                                            double topPx = idx * 70.0;
                                            bool isFav = AppState.IsDayFavorited(dayNum);
                                            
                                            <div class="produx-diagonal-card @(dayNum == 1 ? "day-1-origin" : "") @(isFav ? "is-favorite-card" : "")"
                                                 style="left: @(leftPx)px; top: @(topPx)px;"
                                                 data-index="@idx">
                                                 
                                                 <div class="produx-card-header">
                                                     <div class="produx-header-info">
                                                         <div class="produx-title-star-row">
                                                             <h4 class="produx-card-title">
                                                                 @cardDate.ToString("dddd, d MMMM yyyy", CultureInfo.InvariantCulture)
                                                             </h4>
                                                             @if (isFav)
                                                             {
                                                                 <span class="produx-fav-star" title="Memorable / Starred Day">⭐</span>
                                                             }
                                                         </div>
                                                         <p class="produx-card-sub">
                                                             @(isFav ? "⭐ Memorable Reflection" : (dayNum == 1 ? "Origin Motivation" : (log != null ? FormatMoodTag(log.MoodTag) : (dayNum <= HabitService.CurrentActiveDay ? "Routine Execution" : "Discipline Target"))))
                                                         </p>
                                                     </div>
                                                 </div>

                                                <div class="produx-card-body">
                                                    @if (dayNum <= HabitService.CurrentActiveDay)
                                                    {
                                                        @if (log != null && (!string.IsNullOrWhiteSpace(log.GratitudeNote) || !string.IsNullOrWhiteSpace(log.Note)))
                                                        {
                                                            @if (!string.IsNullOrWhiteSpace(log.GratitudeNote))
                                                            {
                                                                <p class="produx-gratitude-text">@log.GratitudeNote</p>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(log.Note))
                                                            {
                                                                <p class="produx-quote-text">@log.Note</p>
                                                            }
                                                        }
                                                        else if (dayNum == 1)
                                                        {
                                                            <p class="produx-quote-text">
                                                                @(!string.IsNullOrWhiteSpace(AppState.InitialHabitMotivation) ? AppState.InitialHabitMotivation : "I committed to breaking this loop to reclaim my mental clarity, energy, and self-respect.")
                                                            </p>
                                                        }
                                                        else if (dayNum == HabitService.CurrentActiveDay)
                                                        {
                                                            <p class="produx-quote-text">You are facing peak friction right now. Don't compromise your past work.</p>
                                                        }
                                                        else
                                                        {
                                                            <p class="produx-quote-text muted">Showed up and executed protocol with unbroken consistency.</p>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <p class="produx-quote-text muted">Every urge you surf today guarantees victory on this future milestone.</p>
                                                    }
                                                </div>

                                                <div class="produx-card-footer">
                                                    <span class="produx-done-stat">
                                                        ✓ @(HabitService.Habits.Count(h => h.IsCompletedOnDay(dayNum))) / @(HabitService.Habits.Count > 0 ? HabitService.Habits.Count : 6) habits done
                                                    </span>
                                                    @if (dayNum == HabitService.CurrentActiveDay)
                                                    {
                                                        <span class="produx-active-label">TODAY</span>
                                                    }
                                                    else if (dayNum > HabitService.CurrentActiveDay)
                                                    {
                                                        <span class="produx-future-label">UPCOMING</span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- SCENE 1.1: GROUNDING ANCHORS PHOTO CUE & CAROUSEL -->
                <div id="urge-scene-photo-cue" class="urge-scene-layer photo-cue-scene" style="display: none; opacity: 0;">
                    <div class="photo-cue-fullpage-content">
                        <div class="photo-cue-ambient-ring"></div>
                        <span class="photo-cue-kicker">GROUNDING ANCHORS</span>
                        
                        @{
                            var allAnchorCards = AppState.GetEffectiveAnchorCards();
                            bool hasSelfPhoto = allAnchorCards.Any(c => c.Category == "self" && !string.IsNullOrWhiteSpace(c.ImageUrl));
                            var photoCards = allAnchorCards.Where(c => !string.IsNullOrWhiteSpace(c.ImageUrl)).ToList();
                        }

                        <h2 class="photo-cue-giant-heading">
                            @(hasSelfPhoto 
                                ? "Add any loved ones (family, close friends, any partners)" 
                                : "Add your younger version of yourself")
                        </h2>
                        
                        <p class="photo-cue-subheading">
                            You can customize further in settings
                        </p>

                        <!-- Photo Carousel Section -->
                        <div class="photo-cue-carousel-wrapper">
                            <button type="button" 
                                    class="cue-carousel-nav-btn prev-btn @(cueCarouselIndex == 0 ? "disabled" : "")" 
                                    @onclick="PrevCuePhoto"
                                    aria-label="Previous photos">
                                ‹
                            </button>

                            <div class="cue-carousel-viewport" id="cueCarouselViewport">
                                <div class="cue-carousel-track" style="transform: translateX(-@(cueCarouselIndex * 240)px);">
                                    @for (int pi = 0; pi < photoCards.Count; pi++)
                                    {
                                        var pc = photoCards[pi];
                                        <div class="cue-carousel-card existing-photo-card">
                                            <div class="cue-card-img-wrap">
                                                <img src="@pc.ImageUrl" alt="@pc.Title" class="cue-card-img" />
                                            </div>
                                            @if (editingCardId == pc.Id)
                                            {
                                                <div class="cue-card-naming-form">
                                                    <input type="text" 
                                                           class="cue-card-naming-input" 
                                                           placeholder="@(pc.Category == "self" ? "Name (e.g. Younger me, 7yo self...)" : "Name (e.g. Mom, Leo, Buddy...)")" 
                                                           maxlength="28" 
                                                           @bind="editingCardTitle" 
                                                           @bind:event="oninput" 
                                                           @onkeydown="@(e => HandleCardTitleKeyDown(e, pc.Id))" 
                                                           autofocus />
                                                    <div class="cue-naming-btn-row">
                                                        <button type="button" class="cue-naming-save-btn" @onclick="() => SaveCardTitle(pc.Id)">Save</button>
                                                        <button type="button" class="cue-naming-cancel-btn" @onclick="CancelCardTitle">✕</button>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="cue-card-details">
                                                    <div class="cue-card-title-wrap">
                                                        <h4 class="cue-card-title" title="@pc.Title">@pc.Title</h4>
                                                        <button type="button" class="cue-card-edit-btn" title="Edit name" @onclick="() => StartEditingCard(pc)">
                                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                                            </svg>
                                                        </button>
                                                    </div>
                                                    <div class="cue-card-btn-group">
                                                        <button type="button" class="cue-card-crop-btn" title="Adjust / Crop photo" @onclick="() => OpenCropForExistingCard(pc)">
                                                            Crop
                                                        </button>
                                                        <label class="cue-card-replace-btn" title="Change photo">
                                                            <span>Change</span>
                                                            <InputFile OnChange="@(e => HandleCardImageUpload(e, pc.Id))" accept="image/*" style="display:none;" />
                                                        </label>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }

                                    <!-- Furthest right: Placeholder slot for adding a new picture -->
                                    <label class="cue-carousel-card placeholder-photo-card" title="Click to upload picture">
                                        <InputFile OnChange="HandleCuePhotoUpload" accept="image/*" style="display:none;" />
                                        <div class="cue-placeholder-inner">
                                            @if (isUploadingPhoto)
                                            {
                                                <div class="cue-upload-spinner"></div>
                                                <span class="cue-placeholder-text">Loading photo...</span>
                                            }
                                            else
                                            {
                                                <div class="cue-placeholder-icon-wrap">
                                                    <span class="cue-plus-icon">+</span>
                                                </div>
                                                <span class="cue-placeholder-text">
                                                    @(hasSelfPhoto ? "Add Loved One" : "Add Younger Self")
                                                </span>
                                                <span class="cue-placeholder-sub">Click to upload</span>
                                            }
                                        </div>
                                    </label>
                                </div>
                            </div>

                            <button type="button" 
                                    class="cue-carousel-nav-btn next-btn @(cueCarouselIndex >= photoCards.Count ? "disabled" : "")" 
                                    @onclick="NextCuePhoto" 
                                    aria-label="Next photos">
                                ›
                            </button>
                        </div>

                        <!-- Dot Indicators -->
                        <div class="cue-carousel-dots">
                            @for (int di = 0; di <= photoCards.Count; di++)
                            {
                                int dIdx = di;
                                <span class="cue-dot @(cueCarouselIndex == dIdx ? "active" : "")" @onclick="() => cueCarouselIndex = dIdx"></span>
                            }
                        </div>

                        <!-- Confirmation / Proceed OK Button -->
                        <div class="cue-action-row">
                            <button type="button" class="cue-ok-btn" @onclick="HandleCueOk" title="Continue">
                                <span>OK</span>
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M5 12l5 5L20 7"></path>
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- SCENE 1.2: RELATIONAL & SELF-CARE ANCHOR FLASHCARD DECK (SWIPE SCROLL) -->
                <div id="urge-scene-anchors" class="urge-scene-layer anchor-deck-scene" style="display: none; opacity: 0;">
                    <!-- Sleek Transparent Sound Toggle Button on the Right Upper Side -->
                    <button type="button" 
                            id="callMyNameSoundBtn" 
                            class="anchor-sound-btn" 
                            @onclick="ToggleCallMyNameSound" 
                            title="Toggle music sound"
                            aria-label="Toggle music sound">
                        @if (!isCallMyNameMuted)
                        {
                            <span>
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                                    <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                                </svg>
                                <span class="sound-text">SOUND ON</span>
                            </span>
                        }
                        else
                        {
                            <span>
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                                    <line x1="23" y1="9" x2="17" y2="15"></line>
                                    <line x1="17" y1="9" x2="23" y2="15"></line>
                                </svg>
                                <span class="sound-text">SOUND OFF</span>
                            </span>
                        }
                    </button>

                    <div class="anchor-deck-fullpage-content">
                        <div class="anchor-ambient-ring"></div>
                        <span class="anchor-kicker">WHO YOU ARE PROTECTING</span>
                        <h2 class="anchor-giant-heading">Remember who counts on you.</h2>
                        <p class="anchor-subheading">Treat yourself like someone you are responsible for helping.</p>
                        
                        <div class="anchor-card-deck" id="anchorCardDeck">
                            @{
                                var anchorCards = AppState.GetEffectiveAnchorCards();
                            }
                            @for (int i = 0; i < anchorCards.Count; i++)
                            {
                                var card = anchorCards[i];
                                int cardIdx = i;
                                <div class="anchor-card" id="anchorCard_@cardIdx" data-index="@cardIdx">
                                    <div class="anchor-photo-frame">
                                        @if (!string.IsNullOrEmpty(card.ImageUrl))
                                        {
                                            <img src="@card.ImageUrl" alt="@card.Title" class="anchor-photo-img" />
                                        }
                                        else
                                        {
                                            <div class="anchor-photo-placeholder">
                                                <span class="anchor-ph-icon">🛡️</span>
                                            </div>
                                        }
                                    </div>
                                    <div class="anchor-card-meta">
                                        <span class="anchor-category-pill">@card.Category.ToUpperInvariant()</span>
                                        <h3 class="anchor-card-title">@card.Title</h3>
                                        <p class="anchor-card-note">“@card.Note”</p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- SCENE 1.5: "YOU'VE COME THIS FAR..." (STANDALONE FULL-SCREEN MOMENTUM ANCHOR) -->
                <div id="urge-scene-far" class="urge-scene-layer far-scene" style="display: none; opacity: 0;">
                    <div class="far-fullpage-content">
                        <div class="far-ambient-ring"></div>
                        <span class="far-kicker">MOMENTUM RECOGNITION</span>
                        <h2 class="far-giant-quote">“you've come this far...”</h2>
                    </div>
                </div>

                <!-- SCENE 2: THE RAW SPARK (Cinematic Motivation Video) -->
                <div id="urge-scene-2" class="urge-scene-layer spark-scene" style="display: none; opacity: 0;">
                    <div id="shuzoExpandingBox" class="hero-expanding-video-box">
                        <video id="shuzoVideoPlayer" 
                                class="hero-cinematic-video" 
                                muted="@isShuzoMuted" 
                                playsinline 
                                preload="auto"
                                @onclick="HandleVideoClick" 
                                @onended="HandleShuzoEnded">
                            <source src="videos/Never_give_up_!!!.mp4" type="video/mp4" />
                        </video>

                        <!-- Center Replay Overlay Button (ONLY rendered when video has finished) -->
                        @if (isShuzoEnded)
                        {
                            <button type="button" 
                                    id="shuzoPlayCenterBtn" 
                                    class="video-center-play-btn visible" 
                                    @onclick="ReplayShuzo" 
                                    @onclick:stopPropagation="true"
                                    aria-label="Replay Motivation Video">
                                <span class="play-icon-triangle" style="pointer-events: none;">▶</span>
                            </button>
                        }

                        <!-- Sound Toggle Pill Button (Reveals when video expands on scroll) -->
                        <button type="button" 
                                id="shuzoSoundBtn" 
                                class="video-sound-btn" 
                                @onclick="ToggleShuzoSound" 
                                aria-label="Toggle sound">
                            @if (!isShuzoMuted)
                            {
                                <span>
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                                        <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                                    </svg>
                                    <span class="sound-text">SOUND ON</span>
                                </span>
                            }
                            else
                            {
                                <span>
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                                        <line x1="23" y1="9" x2="17" y2="15"></line>
                                        <line x1="17" y1="9" x2="23" y2="15"></line>
                                    </svg>
                                    <span class="sound-text">SOUND OFF</span>
                                </span>
                            }
