    private List<int> GetDayDiaryCards()
    {
        int currentDay = HabitService.CurrentActiveDay;
        int maxAvailableDay = Math.Max(currentDay, 3);
        
        // If total days are within 42, return all days 1..maxAvailableDay
        if (maxAvailableDay <= 42)
        {
            return Enumerable.Range(1, maxAvailableDay).ToList();
        }

        // When exceeding 42 cards, prioritize:
        // 1. Day 1 (Origin)
        // 2. Today (currentDay)
        // 3. Favorited / Memorable days (AppState.FavoriteArchiveDays)
        // 4. Fill remaining slots with recent days
        var selected = new HashSet<int> { 1, currentDay };

        foreach (var fav in AppState.FavoriteArchiveDays.Where(d => d >= 1 && d <= maxAvailableDay))
        {
            selected.Add(fav);
            if (selected.Count >= 42) break;
        }

        for (int d = maxAvailableDay; d >= 1 && selected.Count < 42; d--)
        {
            selected.Add(d);
        }

        // Keep chronological order intact
        return selected.OrderBy(d => d).ToList();
    }

    private string FormatMoodTag(string tag)
    {
        return tag switch
        {
            "sharp" or "high_energy" => "🔥 high energy",
            "good" or "focused" => "✨ good",
            "ok" => "👌 ok",
            "low_energy" => "🌧 low energy",
            "poor" or "high_friction" => "📉 poor",
            _ => "⚡ disciplined"
        };
    }

    private async Task HandleFinishAction(string actionName)
    {
        _wasOpen = false;
        await HabitService.LogUrgeSurfedAsync();
        StopAllAudio();
        await OnClose.InvokeAsync();
    }

    private async Task HandleCancel()
    {
        _wasOpen = false;
        StopAllAudio();
        await OnClose.InvokeAsync();
    }

    private void StopAllAudio()
    {
        try
        {
            _ = JSRuntime.InvokeVoidAsync("eval", @"
                if (window.nobsProduxScrollytelling) {
                    window.nobsProduxScrollytelling.destroy();
                }
                const bg = document.getElementById('urgeBgMusic');
                if (bg) { bg.pause(); bg.currentTime = 0; }
                const ma = document.getElementById('mountainAmbienceAudio');
                if (ma) { ma.pause(); ma.currentTime = 0; }
                const wa = document.getElementById('waterWavesAudio');
                if (wa) { wa.pause(); wa.currentTime = 0; }
                const v1 = document.getElementById('shuzoVideoPlayer');
                if (v1) { v1.pause(); }
                const v2 = document.getElementById('natureVideoPlayer');
                if (v2) { v2.pause(); }
                const ba = document.getElementById('breathingAudioPlayer');
                if (ba) { ba.pause(); ba.currentTime = 0; }
            ");
        }
        catch { }
    }

    public void Dispose()
    {
        StopAllAudio();
    }
