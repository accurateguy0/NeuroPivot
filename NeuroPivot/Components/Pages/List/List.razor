@using NeuroPivot.Components.Pages.List.Components
@inject HabitService HabitService
@inject AppState AppState
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="nobs-container list-container" style="max-width: 1200px;">
    <div class="list-page-header">
        <h1 class="page-title-inter">list</h1>
        @if (HabitService.IsDayLocked)
        {
            <div class="day-locked-banner">
                stand proud, you kept the promise to yourself
            </div>
        }
    </div>

    <div class="nobs-square-card">
        <!-- Header Bar -->
        <div class="card-header-bar">
            <div>
                <h3 class="challenge-title">
                    21-Day Habit Challenge
                </h3>
            </div>
        </div>

        <!-- Progress Bar -->
        <HabitProgressBar />

        <!-- Habit Table -->
        <HabitTable OnToggleHabit="HandleToggleHabit" OnPromptDelete="PromptDelete" />

        <!-- Add Button & Habits Tactical Actions -->
        <div class="table-actions-container">
            <HabitAddButton OnClick="OpenManualAddModal" />

            @if (AppState.CurrentGoal == "habits")
            {
                <div class="habit-tactical-action-bar">
                    <button type="button" class="btn-tactical-urge" @onclick="() => showUrgeModal = true">
                         urge
                    </button>
                    <button type="button" class="btn-tactical-relapse" @onclick="() => showRelapseModal = true">
                        relapse
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<ManualHabitModal IsOpen="showManualAddModal" OnClose="() => showManualAddModal = false" OnSave="CreateManualHabit" />
<ActionAlertModal IsOpen="showAlertPopUp" Message="@alertPopUpMessage" OnClose="() => showAlertPopUp = false" />
<CelebrationModal IsOpen="showCelebrationModal" Message="@celebrationModalMessage" OnClose="() => showCelebrationModal = false" />
<LtpMilestoneModal IsOpen="showLtpModal" OnReinforceSame="ReinforceSame" OnStartNewHabits="StartNewHabits" />
<ConfirmModal IsOpen="showDeleteModal"
              Message="Are you sure? It will reset your progress."
              OnConfirm="ConfirmDelete"
              OnCancel="() => showDeleteModal = false" />

<DailyCheckInModal IsOpen="showDailyCheckInModal" OnClose="HandleCloseCheckIn" />
<RelapseDiagnosticModal IsOpen="showRelapseModal" OnClose="() => showRelapseModal = false" />
<UrgeProtocolModal IsOpen="showUrgeModal" OnClose="() => showUrgeModal = false" />

@code {
    private bool showDeleteModal = false;
    private HabitItem? selectedHabitToDelete;
    private bool showManualAddModal = false;
    private bool showAlertPopUp = false;
    private string alertPopUpMessage = "";
    private bool showCelebrationModal = false;
    private string celebrationModalMessage = "";
    private bool showLtpModal = false;

    // Habits Goal Exclusives: Relapse, Urge & Daily Check-In
    private bool showRelapseModal = false;
    private bool showUrgeModal = false;
    private bool showDailyCheckInModal = false;
    private bool _hasCheckedDailyPopup = false;

    private DailyMoodEntry? todayMoodLog =>
        AppState.DailyMoodLogs.FirstOrDefault(l => l.Date.Date == DateTime.Today);

    protected override void OnInitialized()
    {
        HabitService.CheckRealWorldDateShift();
        HabitService.OnChange += OnStateChanged;
        AppState.OnChange += OnStateChanged;

        CheckAndShowDailyPopup();
    }

    private void CheckAndShowDailyPopup()
    {
        if (!_hasCheckedDailyPopup && AppState.CurrentGoal == "habits" && todayMoodLog == null)
        {
            _hasCheckedDailyPopup = true;
            showDailyCheckInModal = true;
        }
    }

    private void HandleCloseCheckIn()
    {
        showDailyCheckInModal = false;
        _hasCheckedDailyPopup = true;
    }

    private void OnStateChanged()
    {
        CheckAndShowDailyPopup();
        InvokeAsync(StateHasChanged);
    }

    private async Task HandleToggleHabit((string id, int day) item)
    {
        await AttemptToggleHabit(item.id, item.day);
    }

    private async Task AttemptToggleHabit(string id, int day)
    {
        if (HabitService.Habits.Count < 6)
        {
            int remaining = 6 - HabitService.Habits.Count;
            alertPopUpMessage = $"Please finish configuring 6 habits first ({remaining} habit{(remaining > 1 ? "s" : "")} remaining).";
            showAlertPopUp = true;
            return;
        }

        var habit = HabitService.Habits.FirstOrDefault(h => h.Id == id);
        bool wasCompleted = habit?.IsCompletedOnDay(day) ?? false;

        var milestone = await HabitService.ToggleHabitDayAsync(id, day);

        if (!wasCompleted)
        {
            try { await JSRuntime.InvokeVoidAsync("nobsAudio.playPencilScratch", AppState.SoundVolume); } catch { }
        }

        if (milestone == HabitMilestone.ChallengeCompleted)
        {
            showLtpModal = true;
        }
        else if (milestone == HabitMilestone.FourHabitsCompleted)
        {
            celebrationModalMessage = "keep up the good work. 2 more to being an overachiever:))";
            showCelebrationModal = true;
        }
        else if (milestone == HabitMilestone.DayCompleted)
        {
            celebrationModalMessage = "i admire your effort, please keep it up";
            showCelebrationModal = true;
        }
    }

    private void ReinforceSame()
    {
        HabitService.ReinforceChallenge();
        showLtpModal = false;
    }

    private void StartNewHabits()
    {
        HabitService.StartNewChallenge();
        showLtpModal = false;
    }

    private void OpenManualAddModal()
    {
        if (HabitService.Habits.Count >= 6)
        {
            alertPopUpMessage = "You already have 6 habits. Please delete another habit first.";
            showAlertPopUp = true;
            return;
        }
        showManualAddModal = true;
    }

    private void CreateManualHabit(string name)
    {
        if (!string.IsNullOrWhiteSpace(name))
        {
            if (HabitService.Habits.Count >= 6)
            {
                showManualAddModal = false;
                alertPopUpMessage = "You already have 6 habits. Please delete another habit first.";
                showAlertPopUp = true;
                return;
            }
            HabitService.AddHabit(name, "", "Custom");
            showManualAddModal = false;
        }
    }

    private void PromptDelete(HabitItem habit)
    {
        selectedHabitToDelete = habit;
        showDeleteModal = true;
    }

    private void ConfirmDelete()
    {
        if (selectedHabitToDelete != null)
            HabitService.RemoveHabitAndResetProgress(selectedHabitToDelete.Id);
        showDeleteModal = false;
        selectedHabitToDelete = null;
    }

    public void Dispose()
    {
        HabitService.OnChange -= OnStateChanged;
        AppState.OnChange -= OnStateChanged;
    }
}
