@inject AppState AppState
@inject HabitService HabitService
@inject IJSRuntime JSRuntime
@using System.Globalization
@implements IDisposable

<div class="nobs-card animated-fade-in">
    <h2 class="section-heading">
        📊 stats
    </h2>

    <!-- Consecutive Streaks Meter -->
    <div class="streak-meter-card">
        <div class="streak-meter-header">
            <div class="streak-meter-title-wrap">
                <span class="streak-fire-icon">🔥</span>
                <span class="streak-meter-text">Consecutive streaks: <strong class="streak-days-highlight @(isStreakBarScalingDown ? "scaling-down" : "")">@FormatStreakDisplay(streakDays)</strong></span>
            </div>
            <div class="streak-badge @(isTodayQualified ? "qualified" : "pending")">
                @(isTodayQualified ? "✓ Streak active today (4-6 habits done)" : $"{todayCount}/4 habits done today")
            </div>
        </div>

        <div class="streak-track-container">
            <div class="streak-track-bar @(isStreakBarScaling ? "scaling-up" : "") @(isStreakBarScalingDown ? "scaling-down" : "")">
                <div class="streak-fill-bar @(isStreakBarScaling ? "shimmering" : "") @(isStreakBarScalingDown ? "scaling-down" : "") @(isExpandingRight ? "expanding-right" : "draining-left")" style="width: @(streakPercentage)%"></div>
            </div>
            <div class="streak-scale-labels-wrapper" @key="_cascadeStage">
                @if (isStreakBarScalingDown && _outgoingScaleInfo.HasValue)
                {
                    <div class="streak-scale-labels labels-sliding-out">
                        @foreach (var label in _outgoingScaleInfo.Value.Labels)
                        {
                            <span>@label</span>
                        }
                    </div>
                    <div class="streak-scale-labels labels-fading-in">
                        @foreach (var label in scaleInfo.Labels)
                        {
                            <span>@label</span>
                        }
                    </div>
                }
                else
                {
                    <div class="streak-scale-labels @(isStreakBarScaling ? "scaling-up" : "")">
                        @foreach (var label in scaleInfo.Labels)
                        {
                            <span>@label</span>
                        }
                    </div>
                }
            </div>
        </div>
        
        <p class="streak-info-footnote">
            Streak increases when you complete <strong>4 to 6 habits</strong> on a given day.
        </p>

        <div class="streak-test-row">
            <button type="button" class="btn-test-streak" @onclick="() => TriggerTestScaleDown(7)" title="Test with 7-day milestone">
                ⚡ Test (7d)
            </button>
            <button type="button" class="btn-test-streak" @onclick="() => TriggerTestScaleDown(30)" title="Test with 30-day milestone">
                ⚡ Test (30d)
            </button>
        </div>
    </div>

    <!-- 7-Day Consistency Calendar with Navigation Arrows -->
    <div class="calendar-nav-header">
        <button class="carousel-arrow-btn" @onclick="PrevWeek" title="Previous 7 days">‹</button>
        <div class="calendar-month-title">
            📅 @GetWeekTitle()
            @if (weekOffset != 0)
            {
                <button class="btn-today-shortcut" @onclick="ResetToCurrentWeek" title="Jump to current week">Today</button>
            }
        </div>
        <button class="carousel-arrow-btn" @onclick="NextWeek" title="Next 7 days">›</button>
    </div>

    <div class="calendar-7day-grid">
        @foreach (var (day, dow, dayNum) in WeekDays())
        {
            <div class="calendar-day-card @(day.EarnedStar ? "starred" : (day.EarnedCheckmark ? "checked" : "")) @(day.Date.Date == DateTime.Today ? "is-today" : "") @(day.Date.Date == DateTime.Today && isTodayGlowing ? "glowing-today" : "")">
                <div class="dow-label">
                    @dow
                </div>
                <div class="day-num-label">
                    @dayNum
                </div>
                @if (day.EarnedStar)
                {
                    <div class="day-star-icon" title="@day.CompletedCount / @day.TotalCount habits completed (All habits completed!)">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                        </svg>
                    </div>
                }
                else if (day.EarnedCheckmark)
                {
                    <div class="day-check-icon" title="@day.CompletedCount / @day.TotalCount habits completed">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                    </div>
                }
                else
                {
                    <div class="day-empty-circle" title="@day.CompletedCount / @day.TotalCount habits completed">○</div>
                }
            </div>
        }
    </div>

    <!-- History & Day Archives -->
    <div class="friction-log-section">
        <div class="friction-log-header">
            <div class="fl-title-wrap">
                <span class="fl-icon">📝</span>
                <span class="fl-title">History</span>
            </div>
            <div class="fl-header-actions">
                <button type="button" class="btn-history-archives" @onclick="OpenArchivesPage">
                    archives →
                </button>
                <span class="fl-count">@totalHistoryEntries @(totalHistoryEntries == 1 ? "entry" : "entries")</span>
            </div>
        </div>
    </div>
</div>

@if (showMilestoneModal)
{
    <div class="modal-backdrop-overlay" @onclick="CloseMilestoneModal">
        <div class="milestone-solid-square" @onclick:stopPropagation="true">
            <div class="milestone-badge-tag">@milestoneSubtitle</div>
            <h3 class="milestone-modal-title">@milestoneTitle</h3>
            <p class="milestone-modal-message">@milestoneMessage</p>
            <div class="milestone-modal-actions">
                <button class="nobs-btn btn-milestone-continue" @onclick="CloseMilestoneModal">
                    ✨ Claim & Scale Up 🚀
                </button>
            </div>
        </div>
    </div>
}

@code {
    private int weekOffset = 0;
    private bool isTodayGlowing = false;
    private System.Threading.CancellationTokenSource? _glowCts;

    private bool showMilestoneModal = false;
    private int activeMilestoneTier = 0;
    private string milestoneTitle = "";
    private string milestoneSubtitle = "";
    private string milestoneMessage = "";
    private bool isStreakBarScaling = false;
    private System.Threading.CancellationTokenSource? _scaleCts;

    private bool isStreakBarScalingDown = false;
    private int? _overrideStreakDays;
    private System.Threading.CancellationTokenSource? _scaleDownCts;
    private bool _hasStartedScaleDown = false;

    private int? _overridePercentage;
    private (int MaxDays, string[] Labels)? _overrideScaleInfo;
    private (int MaxDays, string[] Labels)? _outgoingScaleInfo;
    private int _cascadeStage = 0;
    private bool isExpandingRight = false;

    private int streakDays => _overrideStreakDays ?? HabitService.GetConsecutiveStreak();
    private int todayCount => HabitService.GetCompletedTodayCount();
    private bool isTodayQualified => HabitService.IsTodayStreakQualified();
    private int streakPercentage => _overridePercentage ?? HabitService.GetStreakMeterPercentage();
    private (int MaxDays, string[] Labels) scaleInfo => _overrideScaleInfo ?? HabitService.GetStreakScaleInfo();

    private int totalHistoryEntries => AppState.DailyMoodLogs.Count + AppState.RelapseLogs.Count;

    protected override void OnInitialized()
    {
        HabitService.OnChange += HandleStateChange;
        AppState.OnChange += HandleStateChange;

        if (HabitService.PendingLostStreak > 0)
        {
            int lostStreak = HabitService.PendingLostStreak;
            _overrideStreakDays = lostStreak;
            _overridePercentage = HabitService.GetStreakMeterPercentageForStreak(lostStreak);
            var startScale = HabitService.GetStreakScaleInfoForStreak(lostStreak, Math.Max(0, lostStreak - 1));
            _overrideScaleInfo = startScale;
            _outgoingScaleInfo = startScale;
        }

        CheckMilestonePopUp();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && HabitService.PendingLostStreak > 0 && !_hasStartedScaleDown)
        {
            _hasStartedScaleDown = true;
            TriggerCinematicStreakScaleDown(HabitService.PendingLostStreak);
        }
    }

    private void OpenArchivesPage()
    {
        AppState.OpenArchives();
    }

    private void HandleStateChange()
    {
        CheckMilestonePopUp();
        if (HabitService.PendingLostStreak > 0 && !_hasStartedScaleDown)
        {
            _hasStartedScaleDown = true;
            TriggerCinematicStreakScaleDown(HabitService.PendingLostStreak);
        }
        InvokeAsync(StateHasChanged);
    }

    private void CheckMilestonePopUp()
    {
        var (hasMilestone, tier, title, subtitle, msg) = HabitService.CheckUnacknowledgedStreakMilestone();
        if (hasMilestone)
        {
            activeMilestoneTier = tier;
            milestoneTitle = title;
            milestoneSubtitle = subtitle;
            milestoneMessage = msg;
            showMilestoneModal = true;
        }
    }


    private async Task CloseMilestoneModal()
    {
        showMilestoneModal = false;
        int tierToAck = activeMilestoneTier;

        // Confetti & Audio Shimmer celebration
        try
        {
            await JSRuntime.InvokeVoidAsync("nobsConfetti.launch");
            await JSRuntime.InvokeVoidAsync("nobsAudio.playShimmer", AppState.SoundVolume);
        }
        catch { }

        // Trigger slow, staged cinematic scale up animation
        TriggerCinematicStreakScale(tierToAck);
    }

    private void TriggerCinematicStreakScale(int tierToAck)
    {
        _scaleCts?.Cancel();
        _scaleCts?.Dispose();
        _scaleCts = new System.Threading.CancellationTokenSource();
        var token = _scaleCts.Token;

        _ = Task.Run(async () =>
        {
            // Phase 1: Hold the completed 100% bar on previous milestone scale so user sees their achievement
            await InvokeAsync(() =>
            {
                _overrideScaleInfo = HabitService.GetStreakScaleInfo();
                _overridePercentage = 100;
                isStreakBarScaling = false;
                StateHasChanged();
            });

            // Pause for 1.8s celebrating the completed milestone
            await Task.Delay(1800, token);
            if (token.IsCancellationRequested) return;

            // Phase 2: Acknowledge on server
            await HabitService.AcknowledgeStreakMilestoneAsync(tierToAck);

            // Phase 3: Start the leftward sliding animation on both labels and fill bar simultaneously
            await InvokeAsync(() =>
            {
                _overrideScaleInfo = HabitService.GetStreakScaleInfo();
                _overridePercentage = HabitService.GetStreakMeterPercentage();
                isStreakBarScaling = true;
                StateHasChanged();
            });

            // Wait for the 2.2s CSS transition to finish gliding
            await Task.Delay(2400, token);
            if (token.IsCancellationRequested) return;

            // Phase 4: Finalize and clear overrides
            await InvokeAsync(() =>
            {
                _overridePercentage = null;
                _overrideScaleInfo = null;
                isStreakBarScaling = false;
                StateHasChanged();
            });
        }, token);
    }

    private void TriggerCinematicStreakScaleDown(int lostStreak)
    {
        _scaleDownCts?.Cancel();
        _scaleDownCts?.Dispose();
        _scaleDownCts = new System.Threading.CancellationTokenSource();
        var token = _scaleDownCts.Token;

        _ = Task.Run(async () =>
        {
            // Milestone tiers in descending order (e.g. for 30: [30, 21, 14, 7, 3])
            var tiers = new List<int>();
            if (lostStreak >= 30) tiers.Add(30);
            if (lostStreak >= 21 && !tiers.Contains(21)) tiers.Add(21);
            if (lostStreak >= 14 && !tiers.Contains(14)) tiers.Add(14);
            if (lostStreak >= 7 && !tiers.Contains(7)) tiers.Add(7);
            if (!tiers.Contains(3)) tiers.Add(3);
            if (tiers[0] != lostStreak) tiers.Insert(0, lostStreak);

            // Phase 1: Hold initial streak level for 800ms so user clearly registers where they started
            await InvokeAsync(() =>
            {
                _cascadeStage = 0;
                _overrideStreakDays = lostStreak;
                _overridePercentage = 100;
                _overrideScaleInfo = HabitService.GetStreakScaleInfoForStreak(lostStreak, Math.Max(0, lostStreak - 1));
                _outgoingScaleInfo = null;
                isStreakBarScalingDown = true;
                isExpandingRight = false;
                StateHasChanged();
            });

            await Task.Delay(800, token);
            if (token.IsCancellationRequested) return;

            // Phase 2: Cascade down through each milestone tier
            for (int k = 0; k < tiers.Count; k++)
            {
                int currentTier = tiers[k];
                int nextTier = (k + 1 < tiers.Count) ? tiers[k + 1] : 0;

                // Drain leftward from currentTier down to nextTier
                await InvokeAsync(() =>
                {
                    isExpandingRight = false;
                    StateHasChanged();
                });

                // Smooth micro-frame interpolation (28 micro-frames over ~800ms) for continuous liquid movement
                int frames = 28;
                int frameDelay = 28;
                double endPct = GetTargetLabelPercentage(currentTier, nextTier);

                for (int f = 1; f <= frames; f++)
                {
                    await Task.Delay(frameDelay, token);
                    if (token.IsCancellationRequested) return;

                    double t = (double)f / (double)frames;
                    double currentVal = (double)currentTier - t * (double)(currentTier - nextTier);
                    int displayVal = (int)Math.Round(currentVal);
                    int pct = (int)Math.Round(100.0 - t * (100.0 - endPct));

                    await InvokeAsync(() =>
                    {
                        _overrideStreakDays = displayVal;
                        _overridePercentage = pct;
                        StateHasChanged();
                    });
                }

                // If nextTier > 0, we entered the previous milestone!
                // Morph labels AND smoothly expand the fill bar to the right (100%)
                if (nextTier > 0)
                {
                    var outgoing = HabitService.GetStreakScaleInfoForStreak(currentTier, Math.Max(0, currentTier - 1));
                    var incoming = HabitService.GetStreakScaleInfoForStreak(nextTier, Math.Max(0, nextTier - 1));

                    await InvokeAsync(() =>
                    {
                        _cascadeStage++;
                        _outgoingScaleInfo = outgoing;
                        _overrideScaleInfo = incoming;
                        isExpandingRight = true;
                        _overridePercentage = 100; // Smooth expansion to the right!
                        StateHasChanged();
                    });

                    // 650ms smooth ease-out expansion to the right
                    await Task.Delay(650, token);
                    if (token.IsCancellationRequested) return;
                }
            }

            // Phase 3: Wait settling buffer on base 0-streak so user clearly sees [0 days, 1 day, 2 days, 3 days]
            await Task.Delay(1200, token);
            if (token.IsCancellationRequested) return;

            // Phase 4: Acknowledge and clear pending lost streak & reset milestone
            await HabitService.ResetMilestoneOnStreakLossAsync();
            await HabitService.ClearPendingLostStreakAsync();

            // Phase 5: Finalize and return to standard live state
            await InvokeAsync(() =>
            {
                _overridePercentage = null;
                _overrideScaleInfo = null;
                _outgoingScaleInfo = null;
                _overrideStreakDays = null;
                isStreakBarScalingDown = false;
                isExpandingRight = false;
                _cascadeStage = 0;
                StateHasChanged();
            });
        }, token);
    }

    private void TriggerTestScaleDown(int days = 30)
    {
        TriggerCinematicStreakScaleDown(days);
    }

    private double GetTargetLabelPercentage(int currentTier, int nextTier)
    {
        if (nextTier <= 0) return 0.0;
        if (currentTier == 30 && nextTier == 21) return 66.7;
        if (currentTier == 21 && nextTier == 14) return 66.7;
        if (currentTier == 14 && nextTier == 7) return 33.3; // Exactly on top of "7 days" label at index 1
        if (currentTier == 7 && nextTier == 3) return 33.3;  // Exactly on top of "3 days" label at index 1
        return ((double)nextTier / (double)currentTier * 100.0);
    }

    private string FormatStreakDisplay(int days)
    {
        if (days >= 365)
        {
            double yrs = Math.Round((double)days / 365.0, 1);
            return $"{days} days ({yrs} {(yrs == 1.0 ? "year" : "years")})";
        }
        return $"{days} {(days == 1 ? "day" : "days")}";
    }

    private void PrevWeek()
    {
        weekOffset--;
    }

    private void NextWeek()
    {
        weekOffset++;
    }

    private void ResetToCurrentWeek()
    {
        weekOffset = 0;
        TriggerTodayGlow();
    }

    private void TriggerTodayGlow()
    {
        _glowCts?.Cancel();
        _glowCts?.Dispose();
        _glowCts = new System.Threading.CancellationTokenSource();
        var token = _glowCts.Token;

        _ = Task.Run(async () =>
        {
            await InvokeAsync(() =>
            {
                isTodayGlowing = true;
                StateHasChanged();
            });

            await Task.Delay(900, token);

            if (!token.IsCancellationRequested)
            {
                await InvokeAsync(() =>
                {
                    isTodayGlowing = false;
                    StateHasChanged();
                });
            }
        }, token);
    }

    private string GetWeekTitle()
    {
        var today = DateTime.Today;
        int daysSinceMonday = ((int)today.DayOfWeek - 1 + 7) % 7;
        var monday = today.AddDays(-daysSinceMonday + (weekOffset * 7));
        var sunday = monday.AddDays(6);

        if (monday.Month == sunday.Month && monday.Year == sunday.Year)
        {
            return $"{monday.ToString("MMMM yyyy", CultureInfo.InvariantCulture)} ({monday.Day}–{sunday.Day})";
        }
        else if (monday.Year == sunday.Year)
        {
            return $"{monday.ToString("MMM d", CultureInfo.InvariantCulture)} – {sunday.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)}";
        }
        else
        {
            return $"{monday.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)} – {sunday.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)}";
        }
    }

    private IEnumerable<(DailyProgress day, string dow, int dayNum)> WeekDays()
    {
        string[] dowNames = { "mon", "tue", "wed", "thu", "fri", "sat", "sun" };
        var history = HabitService.GetLast7DaysHistory(weekOffset);
        for (int i = 0; i < 7; i++)
        {
            var match = history.Count > i ? history[i] : new DailyProgress { Date = DateTime.Today, CompletedCount = 0 };
            yield return (match, dowNames[i], match.Date.Day);
        }
    }

    public void Dispose()
    {
        HabitService.OnChange -= HandleStateChange;
        AppState.OnChange -= HandleStateChange;
        _glowCts?.Cancel();
        _glowCts?.Dispose();
        _scaleCts?.Cancel();
        _scaleCts?.Dispose();
        _scaleDownCts?.Cancel();
        _scaleDownCts?.Dispose();
    }
}
