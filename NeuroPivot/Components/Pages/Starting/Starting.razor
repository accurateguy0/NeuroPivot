@using NeuroPivot.Components.Pages.Starting.Components
@inject AppState AppState
@inject HabitService HabitService
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (AppState.ActiveView == "landing")
{
    <!-- 1. Hero View -->
    <StartingHero OnGetStarted="HandleGetStarted" />

    <!-- 2. 3D Narrative Water Track & Video -->
    <StartingNarrative />

    <!-- 3. Manifesto Section -->
    <StartingManifesto />

    <!-- 4. Core Pillars & Final CTA -->
    <StartingPillars OnGetStarted="HandleGetStarted" />
}

@code {
    private IJSObjectReference? _module;

    protected override void OnInitialized()
    {
        AppState.OnChange += OnStateChanged;
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private async Task HandleGetStarted()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("muteHeroVideo");
            }
            catch { }
        }

        if (AppState.IsLoggedIn)
        {
            if (HabitService.GetTotalHabitsCount() > 0 || !string.IsNullOrWhiteSpace(AppState.CurrentGoal))
            {
                AppState.SetActiveView("recommended");
            }
            else
            {
                AppState.SetActiveView("select_goal");
            }
        }
        else
        {
            AppState.SetActiveView("authentication");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try 
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/nobs-core.js");
                await _module.InvokeVoidAsync("initNeuroPivot");
                await Task.Delay(100); 
                await _module.InvokeVoidAsync("initNarrative");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"JS Error: {ex.Message}"); 
            }                
        }
    }

    public async ValueTask DisposeAsync()
    {
        AppState.OnChange -= OnStateChanged;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("destroyNarrative");
                await _module.DisposeAsync();
            }
            catch { }
        }
    }
}
