@page "/questionnaire/habit"
@using NeuroPivot.Components.Pages.HabitQuestionnaire.Components
@inject AppState AppState
@inject HabitService HabitService
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="nobs-container" style="max-width: 780px;">
    <div class="habit-q-header">
        <h1 class="habit-q-title">
            Habit Diagnostic Protocol
        </h1>
        <div class="habit-q-step-text">
            Step @activeStep of 6
        </div>
        <div class="habit-q-step-track">
            @for (int i = 1; i <= 6; i++)
            {
                int stepNum = i;
                <div class="step-indicator-bar @(stepNum <= activeStep ? "active" : "")"></div>
            }
        </div>
    </div>

    <HabitDiagnosticSteps OnComplete="HandleComplete" OnStepChanged="(s) => activeStep = s" />
</div>

<HabitResultModal IsOpen="showResultModal"
                  AssessedLevel="@AssessedLevel"
                  ResultQuoteTitle="@ResultQuoteTitle"
                  ResultQuoteBody="@ResultQuoteBody"
                  OnClose="() => showResultModal = false"
                  OnProceed="ProceedToRecommended" />

@code {
    private int activeStep = 1;
    private bool showResultModal = false;
    private string ResultQuoteTitle = "";
    private string ResultQuoteBody = "";
    private string AssessedLevel = "";

    protected override void OnInitialized() => AppState.OnChange += OnStateChanged;
    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private void HandleComplete((string category, string q1, string q2, string q3, string q4, string motivation) answers)
    {
        int score = 0;
        if (answers.q1 == "yes") score += 2;
        if (answers.q2 == "no") score += 3;
        if (answers.q3 == "yes") score += 2;
        if (answers.q4 == "yes") score += 3;

        if (!string.IsNullOrWhiteSpace(answers.motivation))
        {
            AppState.SetInitialHabitMotivation(answers.motivation);
        }

        if (score >= 7) {
            AssessedLevel = "addicted";
            ResultQuoteTitle = "consult a specialist";
            ResultQuoteBody = "If you are struggling with addiction, it is important to seek professional help. A specialist can provide guidance and support to help you overcome your addiction. We certainly don't have the ability to offer the same level of support as a trained professional, not because something is wrong with you, but because addiction is a complex condition that requires specialized treatment.";
        } else if (score >= 4) {
            AssessedLevel = "concerning";
            ResultQuoteTitle = "long-term depression for breaking bad habits";
            ResultQuoteBody = "30-240 days of abstinence is required to break a bad habit via long-term depression.";
        } else {
            AssessedLevel = "average";
            ResultQuoteTitle = "you're doing well";
            ResultQuoteBody = "Keep up the good work and continue to make positive choices for your health and well-being.";
        }

        AppState.SetAddictionLevel(AssessedLevel, score);
        showResultModal = true;
    }

    private void ProceedToRecommended() {
        showResultModal = false;
        HabitService.InitializeGoalHabit(AppState.CurrentGoal);
        AppState.SetActiveView("recommended");
    }

    public void Dispose() => AppState.OnChange -= OnStateChanged;
}
